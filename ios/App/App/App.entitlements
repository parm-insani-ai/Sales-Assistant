<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. "development" is what Xcode builds use; an App
	     Store / TestFlight export rewrites it to "production" from the
	     distribution profile, so this value needn't change per build. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
